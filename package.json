{
  "name": "verzel-store-test",
  "version": "1.0.0",
  "description": "Automação de testes da Verzel Store com Playwright, Cucumber e BDD",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --profile smoke",
    "test:ui": "cucumber-js --profile ui",
    "test:api": "cucumber-js --profile api",
    "test:all": "cucumber-js --profile all",
    "report": "start logs\\cucumber-report.html"
  }
}
